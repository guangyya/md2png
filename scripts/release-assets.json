{
  "schemaVersion": 1,
  "assets": [
    {
      "key": "releaseZip",
      "name": "md2png-{version}-macOS-arm64-developer-id.zip",
      "label": "md2png {version} — macOS app archive (Apple silicon)",
      "contentType": "application/zip",
      "sourcePath": "dist/{name}"
    },
    {
      "key": "releaseDmg",
      "name": "md2png-{version}-macOS-arm64-developer-id.dmg",
      "label": "md2png {version} — macOS installer (Apple silicon)",
      "contentType": "application/x-apple-diskimage",
      "sourcePath": "dist/{name}"
    },
    {
      "key": "latestDmg",
      "name": "md2png-latest.dmg",
      "label": "md2png — latest macOS installer (Apple silicon)",
      "contentType": "application/x-apple-diskimage",
      "sourcePath": "dist/{name}"
    },
    {
      "key": "coverageJson",
      "name": "md2png-{version}-coverage.json",
      "label": "md2png {version} — normalized source-line coverage (JSON)",
      "contentType": "application/json",
      "sourcePath": ".build/coverage/{name}"
    },
    {
      "key": "coverageMarkdown",
      "name": "md2png-{version}-coverage.md",
      "label": "md2png {version} — source-line coverage summary (Markdown)",
      "contentType": "application/octet-stream",
      "sourcePath": ".build/coverage/{name}"
    }
  ]
}
